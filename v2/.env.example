# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저로 그대로 나갑니다. 즉 전부 "공개용 키"이고,
# 여기에 비밀 키를 넣으면 안 됩니다. 이 프로젝트는 의도적으로 비밀 키가 하나도
# 없게 설계했습니다 — 데이터 보호는 Supabase RLS 정책이 담당합니다.

# ── Supabase (Project Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Firebase (프로젝트 설정 → 내 앱 → 웹 앱 SDK 구성) ─────
# measurementId(G-XXXX)까지 있어야 Analytics가 켜집니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
